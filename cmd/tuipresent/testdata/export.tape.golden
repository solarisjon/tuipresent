# Generated by tuipresent -export tape for talk.md. Edit freely, then run: vhs <this file>
# Screen 100x30 cells; expects tuipresent on PATH.
Output talk.gif

Set FontSize 16
Set LineHeight 1.2
Set Padding 20
Set Width 1000
Set Height 616
Set Theme { "name": "tuipresent-nord", "background": "#2e3440", "foreground": "#d8dee9", "cursor": "#88c0d0" }

Hide
Type "tuipresent -watch=false -progress=false -mouse=false -images=blocks talk.md"
Enter
Sleep 1s
Show

# slide 1
Sleep 1500ms
Right

# slide 2: Intro
Sleep 1500ms
Right
Sleep 1500ms
Right

# slide 3: ../../Etc/Passwd & Friends!
Sleep 1500ms
Right

# slide 4
Sleep 1500ms

Type "q"
Sleep 500ms
